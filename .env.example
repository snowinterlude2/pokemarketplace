# Copy to .env.local for local dev. Everything prefixed VITE_ ends up in the browser,
# so only PUBLIC values go here. Never put a secret key in a VITE_ variable.

# Supabase (Project Settings > API). The anon key is public by design; RLS protects the data.
# Leave both blank to run the site in demo mode with sample cards.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PayPal REST app Client ID (public). Blank = PayPal's shared sandbox "test" client.
VITE_PAYPAL_CLIENT_ID=
